# Publik resursadress. Connect får en egen host och påverkar inte Open.
CONNECT_RESOURCE_URL=https://connect.promptbanken.se/mcp

# Samma publishable key som webbappen använder. Det är inte en service-nyckel.
CONNECT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

