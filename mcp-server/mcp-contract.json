{
  "version": 1,
  "baseUrl": "https://mcp.promptbanken.se",
  "toolGroups": {
    "public": {
      "tools": [
        "health_check",
        "get_client_routing_instructions",
        "list_templates",
        "search_templates",
        "get_template",
        "list_packages",
        "get_package",
        "list_package_prompts",
        "recommend_packages"
      ],
      "requirements": {
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "additionalProperties": false
        }
      },
      "titles": {
        "health_check": "Kontrollera tjänstens status",
        "get_client_routing_instructions": "Hämta routing- och integritetsregler",
        "list_templates": "Lista publicerade promptmallar",
        "search_templates": "Sök publicerade promptmallar",
        "get_template": "Hämta en publicerad promptmall",
        "list_packages": "Lista publicerade promptpaket",
        "get_package": "Hämta ett publicerat promptpaket",
        "list_package_prompts": "Lista mallar i ett promptpaket",
        "recommend_packages": "Rekommendera promptpaket för en roll"
      }
    },
    "vault": {
      "tools": [
        "list_my_items",
        "search_my_items",
        "get_my_item",
        "save_my_item",
        "update_my_item",
        "archive_my_item",
        "list_active_packages",
        "activate_package",
        "deactivate_package",
        "copy_template_to_valvet"
      ]
    },
    "legacyAuthenticated": {
      "tools": [
        "list_skills",
        "check_input_risk",
        "list_skills_simple",
        "get_skill",
        "list_my_prompts",
        "list_my_private_prompts",
        "list_my_shared_workspaces",
        "list_shared_workspace_prompts",
        "save_workspace_prompt"
      ]
    },
    "admin": {
      "tools": [
        "admin_create_prompt",
        "admin_upsert_prompt_variant",
        "admin_list_draft_prompts",
        "admin_get_prompt",
        "admin_publish_prompt",
        "admin_create_package",
        "admin_add_prompt_to_package",
        "admin_publish_package"
      ]
    }
  },
  "profiles": {
    "public": {
      "endpoint": "/mcp",
      "groups": [
        "public"
      ],
      "auth": {
        "type": "none"
      },
      "blockedCalls": [
        {
          "tool": "list_my_items",
          "arguments": {},
          "expectErrorCode": -32601
        },
        {
          "tool": "admin_create_prompt",
          "arguments": { "slug": "x", "title": "x", "summary": "x", "prompt_text": "x" },
          "expectErrorCode": -32601
        }
      ],
      "healthCall": {
        "tool": "health_check",
        "arguments": {},
        "expectJson": {
          "plan": "public",
          "catalog": "open"
        }
      },
      "corsAllowHeaders": [
        "Content-Type",
        "Authorization",
        "X-MCP-Key"
      ]
    },
    "free": {
      "endpoint": "/mcp/key",
      "groups": [
        "public",
        "vault",
        "legacyAuthenticated"
      ],
      "auth": {
        "type": "workspace_key",
        "keyEnv": "PROMPTBANKEN_FREE_TEST_KEY",
        "globalBearerEnv": "PROMPTBANKEN_GLOBAL_MCP_KEY"
      },
      "skipIfMissingAuth": true,
      "corsAllowHeaders": [
        "Content-Type",
        "Authorization",
        "X-MCP-Key"
      ]
    },
    "sse": {
      "endpoint": "/sse",
      "transport": "sse",
      "groups": [
        "public"
      ],
      "auth": {
        "type": "none"
      },
      "blockedCalls": [
        {
          "tool": "list_my_items",
          "arguments": {},
          "expectIsError": true,
          "expectTextContains": "Unknown tool"
        },
        {
          "tool": "admin_create_prompt",
          "arguments": { "slug": "x", "title": "x", "summary": "x", "prompt_text": "x" },
          "expectIsError": true,
          "expectTextContains": "Unknown tool"
        }
      ],
      "healthCall": {
        "tool": "health_check",
        "arguments": {},
        "expectJson": {
          "plan": "public",
          "catalog": "open"
        }
      }
    },
    "pro": {
      "endpoint": "/mcp/key",
      "groups": [
        "public",
        "vault",
        "legacyAuthenticated"
      ],
      "auth": {
        "type": "workspace_key",
        "keyEnv": "PROMPTBANKEN_PRO_TEST_KEY",
        "globalBearerEnv": "PROMPTBANKEN_GLOBAL_MCP_KEY"
      },
      "skipIfMissingAuth": true,
      "corsAllowHeaders": [
        "Content-Type",
        "Authorization",
        "X-MCP-Key"
      ]
    },
    "admin": {
      "endpoint": "/admin",
      "groups": [
        "admin"
      ],
      "auth": {
        "type": "admin_bearer",
        "keyEnv": "PROMPTBANKEN_ADMIN_TEST_KEY"
      },
      "skipIfMissingAuth": true,
      "expectUnauthorizedWithoutAuth": true
    }
  }
}
