                  ]
                },
                "output_format": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "risk_level": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "low, medium or high."
                },
                "slug": {
                  "type": [
                    "string",
                    "null"
